# Copy to ~/.text2speech/.env (next to config.json) and fill in your keys.
# Never commit it. Override the location with T2S_ENV_FILE if you must.

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: shown on openrouter.ai rankings
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_SITE_NAME=text2speech

# --- Google Gemini (https://aistudio.google.com/apikey) ---
# Used by the built-in "google" provider (gemini-3.8-flash-tts and friends)
GEMINI_API_KEY=AIzaXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Add other provider keys here as you configure them in ~/.text2speech/config.json ---
# OPENAI_API_KEY=sk-xxxxxxxx

# --- App settings (all optional; defaults shown) ---
# T2S_HOST=127.0.0.1
# T2S_PORT=8000
# T2S_MAX_TEXT_CHARS=20000
